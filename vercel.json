{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/calculator", "destination": "https://web-order-app.vercel.app/nutrition" },
    { "source": "/calculator/:path*", "destination": "https://web-order-app.vercel.app/nutrition/:path*" },
    { "source": "/_next/:path*", "destination": "https://web-order-app.vercel.app/_next/:path*" },
    { "source": "/api/:path*", "destination": "https://web-order-app.vercel.app/api/:path*" },
    { "source": "/nutrition/:path*", "destination": "https://web-order-app.vercel.app/nutrition/:path*" }
  ],
  "redirects": [
    { "source": "/trang-chu", "destination": "/", "permanent": true },
    { "source": "/cau-chuyen", "destination": "/about", "permanent": true },
    { "source": "/feedbacks", "destination": "/news", "permanent": true },
    { "source": "/tin-tuc", "destination": "/news", "permanent": true },
    { "source": "/tuyen-dung", "destination": "/careers", "permanent": true }
  ]
}
